# MongoDB Connection String (Prisma requires replicaSet=rs0)
DATABASE_URL="mongodb://127.0.0.1:27017/vibecode?replicaSet=rs0&directConnection=true"

# NextAuth Secret (Any 32+ character string)
AUTH_SECRET="vibe-code-editor-secret-key-32chars-min-change-this"

# Base URL
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth (from Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: GitHub OAuth (from GitHub Developer Settings)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional: Ollama Model for AI Code Suggestions & Chat
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="codellama:latest"
